# ── HealthCore API — Environment Variables ────────────────────────
# Copia este archivo como .env y completa los valores.

# ── JWT ────────────────────────────────────────────────────────────
# Clave secreta para firmar los tokens JWT.
# En producción, genera una clave fuerte con: openssl rand -hex 32
SECRET_KEY=changeme-insecure-dev-key-replace-in-production

# Tiempo de expiración del access token en minutos (default: 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Password Reset (Resend) ────────────────────────────────────────
# API Key de Resend para envío de correos transaccionales.
# Obtén una en: https://resend.com/api-keys
RESEND_API_KEY=

# Tiempo de expiración del token de recuperación en minutos (default: 15)
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

# Clave secreta para firmar los tokens de recuperación.
# Si se deja vacío, usa SECRET_KEY por defecto.
PASSWORD_RESET_TOKEN_SECRET_KEY=

# URL del frontend (para enlaces en correos electrónicos)
FRONTEND_URL=http://localhost:3000

# ── Database ───────────────────────────────────────────────────────
# URL de conexión a PostgreSQL (formato: postgresql://user:password@host:port/db)
# Para desarrollo local, puedes usar SQLite: sqlite:///./dev.db
DATABASE_URL=postgresql://usuario:password@host:5432/healthcore
